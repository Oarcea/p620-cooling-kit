[Unit]
Description=P620 fan curves: P100 shroud fans, CPU cooler and rear exhaust (nct6686)
After=systemd-modules-load.service nvidia-persistenced.service
Wants=nvidia-persistenced.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 -I /usr/local/sbin/p620-fans --config /etc/p620-fans.conf
Restart=always
RestartSec=3
TimeoutStopSec=15
Nice=-5
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
